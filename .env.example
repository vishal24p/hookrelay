# HookRelay — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# WITHOUT these variables → HookRelay uses a free Cloudflare quick tunnel
#                           URL changes on every restart (good for quick testing)
#
# WITH these variables    → HookRelay uses your permanent named tunnel
#                           URL never changes (set in Razorpay/Stripe once, forever)
# ─────────────────────────────────────────────────────────────────────────────


# ── PERMANENT TUNNEL SETUP (optional but recommended) ────────────────────────
#
# Step 1: Create a free Cloudflare account → https://cloudflare.com
# Step 2: Add your domain to Cloudflare (or buy one via Cloudflare Registrar ~$9/yr)
# Step 3: Go to https://one.cloudflare.com → Networks → Tunnels → Create a tunnel
# Step 4: Name it "hookrelay" → copy the token shown
# Step 5: Add a public hostname: hooks.yourdomain.com → http://nginx:80
# Step 6: Paste the token and hostname below

CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=hooks.yourdomain.com

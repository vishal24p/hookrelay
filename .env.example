POSTGRES_USER=webhookuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=webhookdb
DATABASE_URL=postgresql://webhookuser:change-me@postgres:5432/webhookdb

REDIS_URL=redis://redis:6379

CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
MAX_WEBHOOK_BODY_BYTES=1048576

CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=hooks.yourdomain.com

# Local dashboard port exposed by docker-compose.yml.
# Change this only if another service on your machine already uses 8080.
HOOKRELAY_HTTP_PORT=8080

# Log and forwarding defaults. Keep these plain for local debugging.
LOG_LEVEL=info
FORWARD_CONNECT_TIMEOUT_SECONDS=10.0
FORWARD_READ_TIMEOUT_SECONDS=10.0
MAX_WEBHOOK_BODY_BYTES=1048576

# Browser origins allowed to call the local control API.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Forward to apps running on your host machine with host.docker.internal.
# Do not use localhost for host apps from inside Docker; localhost points at the container.
FORWARD_URL_EXAMPLE=http://host.docker.internal:3000/api/webhooks
TUNNEL_HOSTNAME=
